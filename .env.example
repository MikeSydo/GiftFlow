# Django settings
# If the key contains "#" or other special characters, wrap it in quotes.
SECRET_KEY='replace-with-a-long-random-dev-secret-key'
DEBUG=True
DJANGO_LOG_LEVEL=INFO

# Docker + local hosts
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],0.0.0.0,gig_web

# Database (single source of truth for local host runs)
DB_NAME=gig_db
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis / Celery (single source of truth for local host runs)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Scraping
SCRAPING_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Optional overrides. Leave commented unless you explicitly need URL-style config.
# DATABASE_URL=postgresql://postgres:change_me@127.0.0.1:5432/gig_db
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0